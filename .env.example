# YDB Serverless — параметры подключения
YDB_ENDPOINT=
YDB_DATABASE=

# Lockbox — ID секретов
YDB_ENDPOINT_SECRET_ID=
YDB_DATABASE_SECRET_ID=

# AI Studio — агент help-desk
AGENT_ID=
MCP_GATEWAY_URL=

# Telegram
TELEGRAM_BOT_TOKEN_SECRET_ID=
BOT_USERNAME=
OPERATOR_CHAT_ID=
TG_PROXY_KEY_SECRET_ID=
TELEGRAM_API_BASE=

# Внешний сервер с nginx-прокси к Telegram (для scripts/setup-tg-proxy.sh)
TG_PROXY_SERVER=user@host
TG_PROXY_SSH_KEY=~/.ssh/id_ed25519
TG_PROXY_NGINX_CONF=/path/to/nginx/site.conf
TG_PROXY_NGINX_CONTAINER=nginx
TG_PROXY_NGINX_CONF_IN_CONTAINER=/etc/nginx/conf.d/site.conf
